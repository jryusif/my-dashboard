# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your real credentials.
# On Railway / Render, add these in your Project / Service Settings -> Variables.
# ==============================================================================

# 🐘 PostgreSQL Connection String (from Railway, Supabase, Render, Neon, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal_dashboard?sslmode=require"

# 🔐 JWT Secret for signing user authentication tokens (use a long, secure random string)
JWT_SECRET="super-secret-jwt-key-change-this-in-production-random-64-char-string"

# 🌐 Server Port (auto-assigned by Railway / Render; default is 3000 locally)
PORT=3000

# 🚀 Node Environment
NODE_ENV="production"
