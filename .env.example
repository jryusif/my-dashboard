# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your real credentials from Neon & Vercel.
# ==============================================================================

# 🐘 Neon PostgreSQL POOLED Connection String (used by Next.js & Prisma Client in Serverless)
# Format: postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_xxxxxx@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 🔨 Neon PostgreSQL DIRECT Connection String (used by Prisma Migrations)
# Format: postgresql://[user]:[password]@[endpoint-id].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://neondb_owner:npg_xxxxxx@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 🔐 JWT Secret for signing and verifying user authentication tokens
JWT_SECRET="super-secret-jwt-key-change-this-in-production-random-64-char-string"

# 🚀 Node Environment
NODE_ENV="production"
