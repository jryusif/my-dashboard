// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String                  // Hashed with bcrypt
  name                    String?
  avatar                  String?
  role                    String                  @default("USER") // 'ADMIN' | 'USER'
  status                  String                  @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  bio                     String?                 @db.Text
  specialty               String?
  phone                   String?
  persona                 String?                 // 'DOCTOR' | 'DEVELOPER' | 'ENGINEER' | 'TRADER' | 'STUDENT' | 'ENTREPRENEUR' | 'OTHER'
  experienceLevel         String?                 @map("experience_level") // 'Student / Junior' | 'Mid-Level' | 'Senior / Specialist' | 'Lead / Founder'
  primaryFocus            String?                 @map("primary_focus")
  currency                String                  @default("USD")
  dentalApproved          Boolean                 @default(false) @map("dental_approved")
  tradingApproved         Boolean                 @default(false) @map("trading_approved")
  departmentSegments      Json?                   @map("department_segments") // Custom segments per department
  customCategories        Json?                   @map("custom_categories") // Custom category definitions
  onboardingCompleted     Boolean                 @default(false) @map("onboarding_completed")
  oauthProvider           String?                 @map("oauth_provider") // 'google' | 'apple' | 'credentials'
  oauthId                 String?                 @map("oauth_id")
  approvedAt              DateTime?               @map("approved_at")
  approvedBy              String?                 @map("approved_by")
  lastLoginAt             DateTime?               @map("last_login_at")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Tenant-isolated relations
  tasks                   Task[]
  routines                Routine[]
  routineLogs             RoutineLog[]
  dentalCases             DentalCase[]
  workoutSplits           WorkoutSplit[]
  workoutExercises        WorkoutExercise[]
  exerciseWeightLogs      ExerciseWeightLog[]
  workoutExerciseLogs     WorkoutExerciseLog[]
  roadmapMilestones       RoadmapMilestone[]
  financialTransactions   FinancialTransaction[]
  financialGoals          FinancialGoal[]
  financialSetting        FinancialSetting?
  assets                  Asset[]
  goldLots                GoldLot[]
  notificationPreference  NotificationPreference?
  notificationLogs        NotificationLog[]

  // Study Suite Relations
  studyProfile            StudyProfile?
  studySemesters          StudySemester[]
  studySubjects           StudySubject[]
  studyTimetableSlots     StudyTimetableSlot[]
  studyLectures           StudyLecture[]
  studyCourses            StudyCourse[]
  studyResources          StudyResource[]
  studySessions           StudySession[]
  studyGoals              StudyGoal[]
  studyExams              StudyExam[]

  @@index([role])
  @@index([status])
  @@index([persona])
  @@map("users")
}

model Task {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  category    String   // 'Work', 'Studies', 'Workouts', 'Us stocks trading', 'Religion', etc.
  segment     String?
  date        String   // 'YYYY-MM-DD'
  completed   Boolean  @default(false)
  priority    String   @default("Medium") // 'Urgent' | 'High' | 'Medium' | 'Low'
  timeBlock   String?  @map("time_block")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("tasks")
}

model Routine {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  title       String
  type        String       // 'morning' | 'evening'
  time        String?
  order       Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        RoutineLog[]

  @@index([userId, type])
  @@map("routines")
}

model RoutineLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  routineId   String   @map("routine_id")
  date        String   // 'YYYY-MM-DD'
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([userId, routineId, date])
  @@index([userId, date])
  @@map("routine_logs")
}

model DentalCase {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  patientCode         String   @map("patient_code") // e.g. "PT-1042"
  title               String
  specialty           String   // 'Restorative & Aesthetics', 'Endodontics', 'Implantology', etc.
  teeth               String?
  diagnosis           String?  @db.Text
  treatmentPlan       String?  @map("treatment_plan") @db.Text
  clinicalNotes       String?  @map("clinical_notes") @db.Text
  materialsUsed       String?  @map("materials_used")
  totalCost           Float?   @map("total_cost")
  status              String   @default("In Progress") // 'In Progress', 'Completed', 'Maintenance'
  showcaseForPatients Boolean  @default(false) @map("showcase_for_patients")
  date                String   // 'YYYY-MM-DD'
  photos              Json?    // Array of photo objects [{id, stage, url, caption, order}]
  steps               Json?    // Array of treatment steps [{id, title, details, date, completed, order}]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, specialty])
  @@index([userId, patientCode])
  @@map("dental_cases")
}

model WorkoutSplit {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  dayName     String   @map("day_name") // 'Saturday', 'Sunday', etc.
  muscleGroup String   @map("muscle_group") // 'Chest & Triceps (Push A)', etc.
  order       Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayName])
  @@map("workout_splits")
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  dayName     String   @map("day_name")
  name        String
  targetSets  Int      @default(3) @map("target_sets")
  targetReps  String   @default("8-12") @map("target_reps")
  order       Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayName])
  @@map("workout_exercises")
}

model ExerciseWeightLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  exerciseName String   @map("exercise_name")
  weightKg     Float    @map("weight_kg")
  weightLbs    Float    @map("weight_lbs")
  setsReps     String?  @map("sets_reps") // e.g. "3x10"
  isPr         Boolean  @default(false) @map("is_pr")
  notes        String?
  date         String   // 'YYYY-MM-DD'
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseName])
  @@index([userId, date])
  @@map("exercise_weight_logs")
}

model WorkoutExerciseLog {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  exerciseId    String   @map("exercise_id")
  date          String   // 'YYYY-MM-DD'
  completed     Boolean  @default(false)
  completedSets Json?    @map("completed_sets")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, date])
  @@index([userId, date])
  @@map("workout_exercise_logs")
}

model RoadmapMilestone {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  pillar         String   // 'Dental Career', 'Trading & Markets', 'Studies & Knowledge', 'Wealth & Freedom'
  phase          String   // 'Phase 1: Foundation (Now)', etc.
  title          String
  targetHorizon  String?  @map("target_horizon") // 'Q4 2026'
  status         String   @default("in_progress") // 'in_progress', 'upcoming', 'completed'
  priority       String   @default("High") // 'High', 'Medium', 'Low'
  progressPct    Int      @default(0) @map("progress_pct")
  keyResults     Json?    @map("key_results") // Array of [{id, title, done}]
  actionStrategy String?  @map("action_strategy") @db.Text
  metricsTarget  String?  @map("metrics_target")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pillar])
  @@index([userId, phase])
  @@map("roadmap_milestones")
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // 'income' | 'expense'
  category    String
  amount      Float
  date        String   // 'YYYY-MM-DD'
  description String?
  account     String?
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@map("financial_transactions")
}

model FinancialGoal {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  title         String
  targetAmount  Float    @map("target_amount")
  currentAmount Float    @default(0) @map("current_amount")
  deadline      String?
  fundingConfig Json?    @map("funding_config")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("financial_goals")
}

model FinancialSetting {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  currency         String   @default("USD")
  monthlyBudget    Float    @default(3000) @map("monthly_budget")
  savingsTargetPct Float    @default(20) @map("savings_target_pct")
  allocations      Json?    // Custom allocation buckets: [{ name: "Construction", pct: 25 }, ...]
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_settings")
}

model Asset {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  type          String   // 'Gold Bullion', 'Gold Coin', 'Stock', 'Real Estate', 'Crypto', 'Cash'
  status        String   @default("Owned") // 'Owned', 'Planned'
  quantity      Float
  unit          String?  // 'gram', 'ounce', 'kg', 'shares', 'units'
  purchasePrice Float?   @map("purchase_price")
  currency      String?  @default("USD")
  purchaseDate  String?  @map("purchase_date")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("assets")
}

model GoldLot {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  grams       Float
  karat       String   @default("24k")
  pricePaid   Float    @map("price_paid")
  currency    String?  @default("EGP")
  date        String   // 'YYYY-MM-DD'
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gold_lots")
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  tasksReminder  Boolean  @default(true) @map("tasks_reminder")
  reportsDigest  Boolean  @default(true) @map("reports_digest")
  scheduledTimes Json?    @map("scheduled_times") // e.g. ["09:00", "14:00", "21:00"]
  soundEnabled   Boolean  @default(true) @map("sound_enabled")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  type         String   // 'tasks' | 'reports' | 'system'
  title        String
  message      String
  linkCategory String?  @map("link_category")
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notification_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(255)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────
// Stock Screening & Intelligence Suite Models
// ─────────────────────────────────────────────────────────────

model StockCompany {
  id              String                   @id @default(cuid())
  ticker          String                   @unique
  cik             String?                  // 10-digit CIK for SEC EDGAR
  name            String
  exchange        String?                  // NASDAQ, NYSE, etc.
  sector          String?
  industry        String?
  country         String?                  @default("United States")
  hqAddress       String?
  incCountry      String?
  description     String?                  @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  filings         StockFiling[]
  financials      StockFinancialSnapshot[]
  screenings      StockShariahScreening[]
  marketSnapshots StockMarketSnapshot[]
  newsArticles    StockNewsArticle[]

  @@index([ticker])
  @@map("stock_companies")
}

model StockFiling {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  form            String       // 10-K, 10-Q, 8-K
  accessionNumber String       @unique @map("accession_number")
  filingDate      String       @map("filing_date") // YYYY-MM-DD
  reportDate      String?      @map("report_date")
  primaryDocUrl   String?      @map("primary_doc_url")
  isMaterial      Boolean      @default(false) @map("is_material")
  createdAt       DateTime     @default(now()) @map("created_at")

  company         StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, filingDate])
  @@map("stock_filings")
}

model StockFinancialSnapshot {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  fiscalYear        Int?         @map("fiscal_year")
  fiscalPeriod      String?      @map("fiscal_period") // Q1, Q2, Q3, FY
  form              String?      // 10-Q, 10-K
  filingDate        String?      @map("filing_date")
  totalAssets       Float?       @map("total_assets")
  totalDebt         Float?       @map("total_debt")
  cashAndSecurities Float?       @map("cash_and_securities")
  totalRevenue      Float?       @map("total_revenue")
  interestIncome    Float?       @map("interest_income")
  impureIncome      Float?       @map("impure_income")
  marketCapAtReport Float?       @map("market_cap_at_report")
  rawXbrlData       Json?        @map("raw_xbrl_data")
  createdAt         DateTime     @default(now()) @map("created_at")

  company           StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("stock_financial_snapshots")
}

model StockShariahScreening {
  id                 String       @id @default(cuid())
  companyId          String       @map("company_id")
  status             String       // 'PASS' | 'FAIL' | 'REVIEW_REQUIRED' | 'DATA_STALE'
  methodology        String       @default("AAOIFI")
  debtRatioPct       Float?       @map("debt_ratio_pct")
  debtThresholdPct   Float        @default(33.0) @map("debt_threshold_pct")
  cashRatioPct       Float?       @map("cash_ratio_pct")
  cashThresholdPct   Float        @default(33.0) @map("cash_threshold_pct")
  impureRatioPct     Float?       @map("impure_ratio_pct")
  impureThresholdPct Float        @default(5.0) @map("impure_threshold_pct")
  purificationPct    Float?       @map("purification_pct")
  businessActivity   String?      @map("business_activity")
  businessStatus     String?      @map("business_status") // 'PASS' | 'FAIL'
  calculationDetails Json?        @map("calculation_details")
  reviewReasons      Json?        @map("review_reasons")
  screenedAt         DateTime     @default(now()) @map("screened_at")
  expiresAt          DateTime     @map("expires_at")
  lastFilingUsed     String?      @map("last_filing_used")
  previousStatus     String?      @map("previous_status")
  statusChangeNote   String?      @map("status_change_note")

  company            StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, screenedAt])
  @@map("stock_shariah_screenings")
}

model StockMarketSnapshot {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  price             Float
  changePct         Float        @map("change_pct")
  volume            Float?
  avgVolume         Float?       @map("avg_volume")
  rvol              Float?
  freeFloat         Float?       @map("free_float")
  sharesOutstanding Float?       @map("shares_outstanding")
  marketCap         Float?       @map("market_cap")
  bid               Float?
  ask               Float?
  spread            Float?
  dayHigh           Float?       @map("day_high")
  dayLow            Float?       @map("day_low")
  open              Float?
  prevClose         Float?       @map("prev_close")
  fiftyTwoWeekHigh  Float?       @map("fifty_two_week_high")
  fiftyTwoWeekLow   Float?       @map("fifty_two_week_low")
  source            String       @default("Free Market Provider")
  isRealTime        Boolean      @default(false) @map("is_real_time")
  bidAskStatus      String?      @default("Delayed") @map("bid_ask_status")
  quoteTimestamp    DateTime     @default(now()) @map("quote_timestamp")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  company           StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("stock_market_snapshots")
}

model StockNewsArticle {
  id             String       @id @default(cuid())
  companyId      String       @map("company_id")
  headline       String
  summary        String?      @db.Text
  url            String?
  source         String
  publishedAt    DateTime     @map("published_at")
  sentiment      String       @default("Neutral") // 'Positive' | 'Negative' | 'Neutral' | 'Mixed'
  catalyst       String?      // 'Earnings', 'Partnership', 'FDA', 'Guidance', etc.
  importance     String?      @default("MEDIUM")  // 'HIGH' | 'MEDIUM' | 'LOW'
  tradingImpact  String?      @map("trading_impact") // 'Potentially bullish' | 'Potentially bearish' | 'Neutral' | 'Unclear'
  createdAt      DateTime     @default(now()) @map("created_at")

  company        StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publishedAt])
  @@map("stock_news_articles")
}

model StockScannerOpportunity {
  id              String    @id @default(cuid())
  ticker          String
  companyName     String?   @map("company_name")
  price           Float
  changePct       Float     @map("change_pct")
  volume          Float?
  avgVolume       Float?    @map("avg_volume")
  rvol            Float?
  momentum5m      Float?    @map("momentum_5m")
  sharesFloat     Float?    @map("shares_float")
  marketCap       Float?    @map("market_cap")
  headline        String
  summary         String?   @db.Text
  newsUrl         String?   @map("news_url")
  newsSource      String?   @map("news_source")
  newsPublishedAt DateTime  @map("news_published_at")
  catalyst        String?   // 'Earnings', 'FDA Approval', 'Contract', 'Upgrade/Downgrade', 'M&A', etc.
  shariahStatus   String    @default("UNCLASSIFIED") @map("shariah_status") // 'PASS' | 'FAIL' | 'REVIEW_REQUIRED' | 'UNCLASSIFIED'
  statusBadge     String    @default("غير مصنّف") @map("status_badge") // "متوافق ✅" | "غير متوافق ❌" | "قيد المراجعة ⚠️" | "غير مصنّف"
  isArchived      Boolean   @default(false) @map("is_archived")
  matchedRule     String?   @map("matched_rule")
  rawMetrics      Json?     @map("raw_metrics")
  discoveredAt    DateTime  @default(now()) @map("discovered_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([ticker])
  @@index([isArchived, discoveredAt])
  @@map("stock_scanner_opportunities")
}

model StockProcessedNews {
  id          String   @id @default(cuid())
  newsId      String   @unique @map("news_id") // Finnhub ID or SHA/MD5 hash
  ticker      String?
  headline    String
  publishedAt DateTime @map("published_at")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([ticker])
  @@map("stock_processed_news")
}

// ─────────────────────────────────────────────────────────────
// Study & Academic Suite Models
// ─────────────────────────────────────────────────────────────

model StudyProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  mode               String   @default("STUDENT") // 'STUDENT' | 'PROFESSIONAL' | 'GENERAL'
  institution        String?  // University, Medical Center, Organization
  program            String?  // Faculty of Dentistry, Computer Science, etc.
  academicYear       String?  @map("academic_year") // '2026-2027'
  yearLevel          String?  @map("year_level") // 'Year 4', 'Senior Resident', etc.
  activeSemesterId   String?  @map("active_semester_id")
  targetWeeklyHours  Float?   @default(15) @map("target_weekly_hours")
  settings           Json?    // Optional preferences & widget layout
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_profiles")
}

model StudySemester {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  name          String         // 'Semester 1', 'Semester 2', 'Fall 2026', 'Spring 2027'
  academicYear  String?        @map("academic_year")
  startDate     String?        @map("start_date") // 'YYYY-MM-DD'
  endDate       String?        @map("end_date")   // 'YYYY-MM-DD'
  examStartDate String?        @map("exam_start_date")
  examEndDate   String?        @map("exam_end_date")
  isCurrent     Boolean        @default(false) @map("is_current")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects      StudySubject[]

  @@index([userId, isCurrent])
  @@map("study_semesters")
}

model StudySubject {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  semesterId     String?              @map("semester_id")
  name           String               // 'Operative Dentistry', 'Anatomy', etc.
  code           String?              // 'DENT-401'
  color          String               @default("purple") // 'purple', 'peach', 'mint', 'amber', 'rose', 'blue', 'green'
  icon           String               @default("book")   // icon identifier
  category       String?              // 'Clinical', 'Pre-clinical', 'Basic Science'
  creditHours    Float?               @map("credit_hours")
  instructor     String?
  order          Int                  @default(0)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester       StudySemester?       @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  chapters       StudyChapter[]
  lectures       StudyLecture[]
  timetableSlots StudyTimetableSlot[]
  sessions       StudySession[]
  exams          StudyExam[]

  @@index([userId, semesterId])
  @@map("study_subjects")
}

model StudyChapter {
  id            String       @id @default(cuid())
  subjectId     String       @map("subject_id")
  title         String       // 'Chapter 13 — Composite Restorations'
  chapterNumber Int?         @map("chapter_number")
  order         Int          @default(0)
  status        String       @default("NOT_STARTED") // 'NOT_STARTED' | 'IN_PROGRESS' | 'COMPLETED'
  notes         String?      @db.Text
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  subject       StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, order])
  @@map("study_chapters")
}

model StudyTimetableSlot {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  subjectId   String?       @map("subject_id")
  title       String        // 'Operative Dentistry Lecture'
  dayOfWeek   String        // 'Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'
  startTime   String        // '09:00'
  endTime     String        // '11:00'
  type        String        @default("Lecture") // 'Lecture' | 'Section' | 'Lab' | 'Tutorial' | 'Other'
  instructor  String?
  location    String?       // 'Lecture Hall B', 'Phantom Lab 2'
  color       String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     StudySubject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("study_timetable_slots")
}

model StudyLecture {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  subjectId       String?       @map("subject_id")
  timetableSlotId String?       @map("timetable_slot_id")
  title           String
  type            String        @default("Lecture") // 'Lecture' | 'Section' | 'Lab' | 'Tutorial' | 'Other'
  date            String        // 'YYYY-MM-DD'
  startTime       String?       @map("start_time")
  endTime         String?       @map("end_time")
  instructor      String?
  location        String?
  notes           String?       @db.Text
  completed       Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         StudySubject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, subjectId])
  @@map("study_lectures")
}

model StudyCourse {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  provider         String?  // 'Coursera', 'Masterclass', 'Hospital CME', etc.
  instructor       String?
  category         String?
  color            String   @default("peach")
  icon             String   @default("laptop")
  startDate        String?  @map("start_date")
  endDate          String?  @map("end_date")
  status           String   @default("IN_PROGRESS") // 'PLANNED' | 'IN_PROGRESS' | 'COMPLETED'
  totalModules     Int      @default(0) @map("total_modules")
  completedModules Int      @default(0) @map("completed_modules")
  totalLessons     Int      @default(0) @map("total_lessons")
  completedLessons Int      @default(0) @map("completed_lessons")
  modules          Json?    // Array of [{id, title, completed, lessons: [{id, title, completed}]}]
  notes            String?  @db.Text
  linkUrl          String?  @map("link_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("study_courses")
}

model StudyResource {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  subjectId   String?  @map("subject_id")
  courseId    String?  @map("course_id")
  title       String
  author      String?
  type        String   @default("BOOK") // 'BOOK' | 'PDF' | 'ARTICLE' | 'WEBSITE' | 'VIDEO' | 'CLINICAL'
  category    String?
  color       String   @default("mint")
  totalPages  Int?     @map("total_pages")
  currentPage Int?     @default(0) @map("current_page")
  status      String   @default("READING") // 'WANT_TO_READ' | 'READING' | 'COMPLETED'
  linkUrl     String?  @map("link_url")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("study_resources")
}

model StudySession {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  subjectId       String?       @map("subject_id")
  courseId        String?       @map("course_id")
  date            String        // 'YYYY-MM-DD'
  durationMinutes Int           @map("duration_minutes")
  type            String        @default("Revision") // 'Reading' | 'Video' | 'Revision' | 'Practice' | 'Lecture' | 'Lab'
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("study_sessions")
}

model StudyGoal {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  title      String
  timeframe  String   @default("WEEKLY") // 'DAILY' | 'WEEKLY' | 'MONTHLY'
  targetDate String?  @map("target_date")
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timeframe])
  @@map("study_goals")
}

model StudyExam {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  subjectId   String?      @map("subject_id")
  title       String       // 'Operative Dentistry Midterm Exam'
  date        String       // 'YYYY-MM-DD'
  time        String?      // '10:00 AM'
  location    String?      // 'Main Exam Hall 3'
  weightPct   Float?       @map("weight_pct")
  grade       String?      // 'A+', '92%'
  notes       String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     StudySubject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_exams")
}


