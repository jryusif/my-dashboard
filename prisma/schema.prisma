// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String                  // Hashed with bcrypt
  name                    String?
  avatar                  String?
  role                    String                  @default("USER") // 'ADMIN' | 'USER'
  status                  String                  @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  bio                     String?                 @db.Text
  specialty               String?
  phone                   String?
  persona                 String?                 // 'DOCTOR' | 'DEVELOPER' | 'ENGINEER' | 'TRADER' | 'STUDENT' | 'ENTREPRENEUR' | 'OTHER'
  experienceLevel         String?                 @map("experience_level") // 'Student / Junior' | 'Mid-Level' | 'Senior / Specialist' | 'Lead / Founder'
  primaryFocus            String?                 @map("primary_focus")
  currency                String                  @default("USD")
  dentalApproved          Boolean                 @default(false) @map("dental_approved")
  tradingApproved         Boolean                 @default(false) @map("trading_approved")
  departmentSegments      Json?                   @map("department_segments") // Custom segments per department
  customCategories        Json?                   @map("custom_categories") // Custom category definitions
  onboardingCompleted     Boolean                 @default(false) @map("onboarding_completed")
  oauthProvider           String?                 @map("oauth_provider") // 'google' | 'apple' | 'credentials'
  oauthId                 String?                 @map("oauth_id")
  approvedAt              DateTime?               @map("approved_at")
  approvedBy              String?                 @map("approved_by")
  lastLoginAt             DateTime?               @map("last_login_at")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Tenant-isolated relations
  tasks                   Task[]
  routines                Routine[]
  routineLogs             RoutineLog[]
  dentalCases             DentalCase[]
  workoutSplits           WorkoutSplit[]
  workoutExercises        WorkoutExercise[]
  exerciseWeightLogs      ExerciseWeightLog[]
  workoutExerciseLogs     WorkoutExerciseLog[]
  roadmapMilestones       RoadmapMilestone[]
  financialTransactions   FinancialTransaction[]
  financialGoals          FinancialGoal[]
  financialSetting        FinancialSetting?
  assets                  Asset[]
  goldLots                GoldLot[]
  notificationPreference  NotificationPreference?
  notificationLogs        NotificationLog[]

  @@index([role])
  @@index([status])
  @@index([persona])
  @@map("users")
}

model Task {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  category    String   // 'Work', 'Studies', 'Workouts', 'Us stocks trading', 'Religion', etc.
  segment     String?
  date        String   // 'YYYY-MM-DD'
  completed   Boolean  @default(false)
  priority    String   @default("Medium") // 'Urgent' | 'High' | 'Medium' | 'Low'
  timeBlock   String?  @map("time_block")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("tasks")
}

model Routine {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  title       String
  type        String       // 'morning' | 'evening'
  time        String?
  order       Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        RoutineLog[]

  @@index([userId, type])
  @@map("routines")
}

model RoutineLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  routineId   String   @map("routine_id")
  date        String   // 'YYYY-MM-DD'
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([userId, routineId, date])
  @@index([userId, date])
  @@map("routine_logs")
}

model DentalCase {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  patientCode         String   @map("patient_code") // e.g. "PT-1042"
  title               String
  specialty           String   // 'Restorative & Aesthetics', 'Endodontics', 'Implantology', etc.
  teeth               String?
  diagnosis           String?  @db.Text
  treatmentPlan       String?  @map("treatment_plan") @db.Text
  clinicalNotes       String?  @map("clinical_notes") @db.Text
  materialsUsed       String?  @map("materials_used")
  totalCost           Float?   @map("total_cost")
  status              String   @default("In Progress") // 'In Progress', 'Completed', 'Maintenance'
  showcaseForPatients Boolean  @default(false) @map("showcase_for_patients")
  date                String   // 'YYYY-MM-DD'
  photos              Json?    // Array of photo objects [{id, stage, url, caption, order}]
  steps               Json?    // Array of treatment steps [{id, title, details, date, completed, order}]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, specialty])
  @@index([userId, patientCode])
  @@map("dental_cases")
}

model WorkoutSplit {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  dayName     String   @map("day_name") // 'Saturday', 'Sunday', etc.
  muscleGroup String   @map("muscle_group") // 'Chest & Triceps (Push A)', etc.
  order       Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayName])
  @@map("workout_splits")
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  dayName     String   @map("day_name")
  name        String
  targetSets  Int      @default(3) @map("target_sets")
  targetReps  String   @default("8-12") @map("target_reps")
  order       Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayName])
  @@map("workout_exercises")
}

model ExerciseWeightLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  exerciseName String   @map("exercise_name")
  weightKg     Float    @map("weight_kg")
  weightLbs    Float    @map("weight_lbs")
  setsReps     String?  @map("sets_reps") // e.g. "3x10"
  isPr         Boolean  @default(false) @map("is_pr")
  notes        String?
  date         String   // 'YYYY-MM-DD'
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseName])
  @@index([userId, date])
  @@map("exercise_weight_logs")
}

model WorkoutExerciseLog {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  exerciseId    String   @map("exercise_id")
  date          String   // 'YYYY-MM-DD'
  completed     Boolean  @default(false)
  completedSets Json?    @map("completed_sets")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, date])
  @@index([userId, date])
  @@map("workout_exercise_logs")
}

model RoadmapMilestone {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  pillar         String   // 'Dental Career', 'Trading & Markets', 'Studies & Knowledge', 'Wealth & Freedom'
  phase          String   // 'Phase 1: Foundation (Now)', etc.
  title          String
  targetHorizon  String?  @map("target_horizon") // 'Q4 2026'
  status         String   @default("in_progress") // 'in_progress', 'upcoming', 'completed'
  priority       String   @default("High") // 'High', 'Medium', 'Low'
  progressPct    Int      @default(0) @map("progress_pct")
  keyResults     Json?    @map("key_results") // Array of [{id, title, done}]
  actionStrategy String?  @map("action_strategy") @db.Text
  metricsTarget  String?  @map("metrics_target")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pillar])
  @@index([userId, phase])
  @@map("roadmap_milestones")
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // 'income' | 'expense'
  category    String
  amount      Float
  date        String   // 'YYYY-MM-DD'
  description String?
  account     String?
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@map("financial_transactions")
}

model FinancialGoal {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  title         String
  targetAmount  Float    @map("target_amount")
  currentAmount Float    @default(0) @map("current_amount")
  deadline      String?
  fundingConfig Json?    @map("funding_config")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("financial_goals")
}

model FinancialSetting {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  currency         String   @default("USD")
  monthlyBudget    Float    @default(3000) @map("monthly_budget")
  savingsTargetPct Float    @default(20) @map("savings_target_pct")
  allocations      Json?    // Custom allocation buckets: [{ name: "Construction", pct: 25 }, ...]
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_settings")
}

model Asset {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  type          String   // 'Gold Bullion', 'Gold Coin', 'Stock', 'Real Estate', 'Crypto', 'Cash'
  status        String   @default("Owned") // 'Owned', 'Planned'
  quantity      Float
  unit          String?  // 'gram', 'ounce', 'kg', 'shares', 'units'
  purchasePrice Float?   @map("purchase_price")
  currency      String?  @default("USD")
  purchaseDate  String?  @map("purchase_date")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("assets")
}

model GoldLot {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  grams       Float
  karat       String   @default("24k")
  pricePaid   Float    @map("price_paid")
  currency    String?  @default("EGP")
  date        String   // 'YYYY-MM-DD'
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gold_lots")
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  tasksReminder  Boolean  @default(true) @map("tasks_reminder")
  reportsDigest  Boolean  @default(true) @map("reports_digest")
  scheduledTimes Json?    @map("scheduled_times") // e.g. ["09:00", "14:00", "21:00"]
  soundEnabled   Boolean  @default(true) @map("sound_enabled")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  type         String   // 'tasks' | 'reports' | 'system'
  title        String
  message      String
  linkCategory String?  @map("link_category")
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notification_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(255)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────
// Stock Screening & Intelligence Suite Models
// ─────────────────────────────────────────────────────────────

model StockCompany {
  id              String                   @id @default(cuid())
  ticker          String                   @unique
  cik             String?                  // 10-digit CIK for SEC EDGAR
  name            String
  exchange        String?                  // NASDAQ, NYSE, etc.
  sector          String?
  industry        String?
  country         String?                  @default("United States")
  hqAddress       String?
  incCountry      String?
  description     String?                  @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  filings         StockFiling[]
  financials      StockFinancialSnapshot[]
  screenings      StockShariahScreening[]
  marketSnapshots StockMarketSnapshot[]
  newsArticles    StockNewsArticle[]

  @@index([ticker])
  @@map("stock_companies")
}

model StockFiling {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  form            String       // 10-K, 10-Q, 8-K
  accessionNumber String       @unique @map("accession_number")
  filingDate      String       @map("filing_date") // YYYY-MM-DD
  reportDate      String?      @map("report_date")
  primaryDocUrl   String?      @map("primary_doc_url")
  isMaterial      Boolean      @default(false) @map("is_material")
  createdAt       DateTime     @default(now()) @map("created_at")

  company         StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, filingDate])
  @@map("stock_filings")
}

model StockFinancialSnapshot {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  fiscalYear        Int?         @map("fiscal_year")
  fiscalPeriod      String?      @map("fiscal_period") // Q1, Q2, Q3, FY
  form              String?      // 10-Q, 10-K
  filingDate        String?      @map("filing_date")
  totalAssets       Float?       @map("total_assets")
  totalDebt         Float?       @map("total_debt")
  cashAndSecurities Float?       @map("cash_and_securities")
  totalRevenue      Float?       @map("total_revenue")
  interestIncome    Float?       @map("interest_income")
  impureIncome      Float?       @map("impure_income")
  marketCapAtReport Float?       @map("market_cap_at_report")
  rawXbrlData       Json?        @map("raw_xbrl_data")
  createdAt         DateTime     @default(now()) @map("created_at")

  company           StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("stock_financial_snapshots")
}

model StockShariahScreening {
  id                 String       @id @default(cuid())
  companyId          String       @map("company_id")
  status             String       // 'PASS' | 'FAIL' | 'REVIEW_REQUIRED' | 'DATA_STALE'
  methodology        String       @default("AAOIFI")
  debtRatioPct       Float?       @map("debt_ratio_pct")
  debtThresholdPct   Float        @default(33.0) @map("debt_threshold_pct")
  cashRatioPct       Float?       @map("cash_ratio_pct")
  cashThresholdPct   Float        @default(33.0) @map("cash_threshold_pct")
  impureRatioPct     Float?       @map("impure_ratio_pct")
  impureThresholdPct Float        @default(5.0) @map("impure_threshold_pct")
  purificationPct    Float?       @map("purification_pct")
  businessActivity   String?      @map("business_activity")
  businessStatus     String?      @map("business_status") // 'PASS' | 'FAIL'
  calculationDetails Json?        @map("calculation_details")
  reviewReasons      Json?        @map("review_reasons")
  screenedAt         DateTime     @default(now()) @map("screened_at")
  expiresAt          DateTime     @map("expires_at")
  lastFilingUsed     String?      @map("last_filing_used")
  previousStatus     String?      @map("previous_status")
  statusChangeNote   String?      @map("status_change_note")

  company            StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, screenedAt])
  @@map("stock_shariah_screenings")
}

model StockMarketSnapshot {
  id                String       @id @default(cuid())
  companyId         String       @map("company_id")
  price             Float
  changePct         Float        @map("change_pct")
  volume            Float?
  avgVolume         Float?       @map("avg_volume")
  rvol              Float?
  freeFloat         Float?       @map("free_float")
  sharesOutstanding Float?       @map("shares_outstanding")
  marketCap         Float?       @map("market_cap")
  bid               Float?
  ask               Float?
  spread            Float?
  dayHigh           Float?       @map("day_high")
  dayLow            Float?       @map("day_low")
  open              Float?
  prevClose         Float?       @map("prev_close")
  fiftyTwoWeekHigh  Float?       @map("fifty_two_week_high")
  fiftyTwoWeekLow   Float?       @map("fifty_two_week_low")
  source            String       @default("Free Market Provider")
  isRealTime        Boolean      @default(false) @map("is_real_time")
  bidAskStatus      String?      @default("Delayed") @map("bid_ask_status")
  quoteTimestamp    DateTime     @default(now()) @map("quote_timestamp")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  company           StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("stock_market_snapshots")
}

model StockNewsArticle {
  id             String       @id @default(cuid())
  companyId      String       @map("company_id")
  headline       String
  summary        String?      @db.Text
  url            String?
  source         String
  publishedAt    DateTime     @map("published_at")
  sentiment      String       @default("Neutral") // 'Positive' | 'Negative' | 'Neutral' | 'Mixed'
  catalyst       String?      // 'Earnings', 'Partnership', 'FDA', 'Guidance', etc.
  importance     String?      @default("MEDIUM")  // 'HIGH' | 'MEDIUM' | 'LOW'
  tradingImpact  String?      @map("trading_impact") // 'Potentially bullish' | 'Potentially bearish' | 'Neutral' | 'Unclear'
  createdAt      DateTime     @default(now()) @map("created_at")

  company        StockCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publishedAt])
  @@map("stock_news_articles")
}

