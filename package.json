{
  "name": "my-personal-dashboard",
  "version": "1.0.0",
  "description": "A modern personal productivity dashboard backed by a Notion database.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
